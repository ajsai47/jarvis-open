{
  "manifest_version": 3,
  "name": "Jarvis for Dia",
  "version": "0.3.0",
  "description": "Lets Jarvis (on this Mac, at 127.0.0.1:8765) work in its own background tabs. Each action is logged in Jarvis.",
  "key": "",
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Jarvis"
  },
  "minimum_chrome_version": "120"
}